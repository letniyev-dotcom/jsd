<?xml version="1.0" encoding="utf-8"?>
<!--
  Пути, которые FileProvider разрешает раздавать через content:// URI.
  Скачанный/распакованный APK пишется в getTemporaryDirectory() (cache dir
  приложения), поэтому достаточно cache-path.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="cache" path="." />
    <external-cache-path name="external_cache" path="." />
</paths>
